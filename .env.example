# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Node Runtime Environment & Server
NODE_ENV=production
PORT=3000

# PostgreSQL Database Configuration (Neon PostgreSQL / Cloud SQL / Self-hosted PostgreSQL)
SQL_HOST=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=
SQL_PORT=5432
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=
# SQL_SSL: 'true' enables TLS with strict CA verification (default for remote hosts like Neon). Set 'false' only for local non-SSL.
SQL_SSL=true
PGSSLMODE=require

# JWT Authentication Secrets
JWT_SECRET=
JWT_REFRESH_SECRET=

# Allowed CORS Origins (Comma-separated, e.g. https://turfbd.com,https://turfbd.vercel.app)
ALLOWED_ORIGINS=

# Feature Flags for Social Login (Explicitly false by default across Preview & Production)
# Set to 'true' only when verified provider credentials are configured
ENABLE_GOOGLE_OAUTH=false
ENABLE_FACEBOOK_OAUTH=false
VITE_ENABLE_GOOGLE_OAUTH=false
VITE_ENABLE_FACEBOOK_OAUTH=false

# Google OAuth 2.0 Configuration (Server-side)
# Obtain from Google Cloud Console: APIs & Services -> Credentials -> Create Credentials -> OAuth Client ID (Web Application)
# Authorized redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Facebook / Meta Login Configuration (Server-side)
# Obtain from Meta for Developers: App Dashboard -> Use cases -> Authentication and account creation (Facebook Login)
# Valid OAuth Redirect URIs: <APP_URL>/api/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=

# Optional Custom Frontend / API Base URLs (Defaults dynamically to request origin or APP_URL)
FRONTEND_URL=
API_BASE_URL=

# Persistent Image Storage Provider Configuration
# Supported providers: 'cloudinary' (Primary MVP zero-cost provider) | 'r2' (Cloudflare R2) | 'gcs'
IMAGE_STORAGE_PROVIDER=cloudinary

# Cloudinary Storage (Primary MVP Provider - Generous Free Tier, Zero-Cost)
# Obtain from Cloudinary Dashboard -> API Keys & Programmable Media
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=turfbd/gallery

# Cloudflare R2 S3-Compatible Object Storage (Alternative Provider for Future Scale)
# Obtain from Cloudflare Dashboard -> R2 -> Manage R2 API Tokens (Permissions: Object Read & Write)
# R2 Endpoint format: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public read URL for the R2 bucket (e.g. custom domain or r2.dev public URL, e.g. https://images.turfbd.com)
R2_PUBLIC_BASE_URL=

# Google Cloud Storage (Secondary / Legacy object storage)
GCS_BUCKET_NAME=

# Bangladesh Payment Gateways (bKash, Nagad, SSLCommerz)
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_SANDBOX=true

NAGAD_MERCHANT_ID=
NAGAD_SANDBOX=true

SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASS=
SSLCOMMERZ_SANDBOX=true

# Bangladesh SMS OTP Gateways (Greenweb BD, SSL Wireless, or Twilio)
GREENWEB_SMS_API_TOKEN=
SSL_SMS_API_TOKEN=
SSL_SMS_SID=
SSL_SMS_DOMAIN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=

# Transactional Email Gateway (SMTP / SendGrid)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TurfBD <no-reply@turfbd.com>"
SMTP_SECURE=false
SENDGRID_API_KEY=

# Google Maps Platform (Turf Discovery & Interactive Arena Map)
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
