{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "db:push": "drizzle-kit push --config=src/db/drizzle.config.ts",
    "db:seed": "tsx scripts/seed.ts",
    "admin:create": "tsx scripts/create_admin.ts",
    "admin:create:secure": "tsx scripts/create_admin_secure.ts",
    "test:regression": "tsx scripts/regression_test.ts",
    "test:payments": "tsx test_payment_regression.ts",
    "test:phase7": "tsx scripts/test_phase7_checkin.ts",
    "test:phase8": "tsx scripts/test_phase8_verification.ts",
    "test:phase9": "tsx scripts/test_phase9_verification.ts",
    "test:superadmin": "tsx scripts/test_super_admin_security.ts",
    "test:ui-roles": "tsx scripts/test_ui_and_role_views.ts",
    "test:oauth": "tsx scripts/test_oauth_verification.ts",
    "test:disabled-oauth": "tsx scripts/test_disabled_oauth.ts",
    "test:logo": "tsx scripts/test_logo_consistency.ts",
    "test:phase11": "tsx scripts/test_phase11_mobile_pwa_responsive.ts",
    "test:install-visibility": "tsx scripts/test_install_button_visibility.ts",
    "test:r2-storage": "tsx scripts/test_r2_storage.ts",
    "test:cloudinary-storage": "tsx scripts/test_cloudinary_storage.ts",
    "test:pwa-mobile": "tsx scripts/test_mobile_pwa_install.ts",
    "desktop:build": "npm run build && echo 'Desktop bundle ready in dist/'"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@google-cloud/storage": "^8.0.1",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vis.gl/react-google-maps": "^1.10.0",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.3.0",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sharp": "^0.35.4",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/sharp": "^0.32.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
